<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App privacy manifest (required since Spring 2024 for required-reason APIs).
     - NSPrivacyAccessedAPICategoryUserDefaults / CA92.1: the app stores only
       its own settings (language, paywall state, quota ledger) in UserDefaults.
     - NSPrivacyTracking=true: the free tier shows Google AdMob rewarded ads
       (plus Google UMP consent). AdMob may use the advertising identifier
       for personalized ads when the user allows tracking — see the App Store
       Connect privacy questionnaire + in-app privacy policy (Advertising).
       The app's own code collects nothing and sends nothing anywhere except
       the user-configured VPN servers. -->
<plist version="1.0">
<dict>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyTracking</key>
	<true/>
	<key>NSPrivacyTrackingDomains</key>
	<array>
		<string>googleads.g.doubleclick.net</string>
		<string>pagead2.googlesyndication.com</string>
	</array>
</dict>
</plist>
