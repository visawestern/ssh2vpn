    <string name="dns_desc_adguard">Blockiert Werbung, Tracker, Analyse-Pixel und Malware. Manche Sites können Probleme machen (Anti-Adblock).</string>
    <string name="dns_desc_adguard_family">Blockiert Erwachseneninhalte, Werbung, Tracker und Malware; erzwingt sichere Suche.</string>
    <string name="dns_desc_adguard_unfiltered">AdGuards schlichter Resolver: keinerlei Blockierung, Datenschutz vor allem, keine DNS-Protokolle.</string>
    <string name="dns_desc_cleanbrowsing_adult">Blockiert nur Erwachsenenseiten (18+); alles andere ist erlaubt.</string>
    <string name="dns_desc_cleanbrowsing_family">Strenger Modus: blockiert Erwachseneninhalte, Malware und Phishing; sichere Suche bei Google/Bing/Yandex.</string>
    <string name="dns_desc_cloudflare">Der schnellste öffentliche Resolver. Keine Inhaltsfilterung; Abfrageprotokolle werden nach 24h gelöscht.</string>
    <string name="dns_desc_cloudflare_family">Blockiert Inhalte für Erwachsene (18+) und Malware.</string>
    <string name="dns_desc_cloudflare_malware">Cloudflare-Geschwindigkeit plus Sperrliste für Malware- und Phishing-Domänen.</string>
    <string name="dns_desc_comodo">Blockiert bösartige Domänen und Phishing.</string>
    <string name="dns_desc_dns0_zero">EU-Non-Profit. Blockiert Malware- und Phishing-Domänen.</string>
    <string name="dns_desc_dns_watch">Deutschland, datenschutzfreundlich, ohne Filter und Protokolle.</string>
    <string name="dns_desc_google">Globales Anycast von Google. Keine Inhaltsfilterung, standardmäßige Google-Datenschutzrichtlinie.</string>
    <string name="dns_desc_level3">Klassischer Veteran unter den Resolvern. Keine Filterung.</string>
    <string name="dns_desc_opendns">Resolver von Cisco. Blockiert Phishing und Identitätsdiebstahl.</string>
    <string name="dns_desc_opendns_familyshield">Vorkonfiguriert: blockiert Erwachseneninhalte und Phishing. Kein Einrichten nötig.</string>
    <string name="dns_desc_quad9">Blockiert Malware, Phishing und Botnet-Kontrolldomänen. Schweizer Non-Profit; keine IP-Protokollierung.</string>
    <string name="dns_desc_verisign">Stabile US-Infrastruktur. Keine Filterung.</string>
    <string name="dns_desc_yandex">Am schnellsten in Russland/GUS. Keine Filterung.</string>
    <string name="dns_desc_yandex_family">Blockiert Erwachseneninhalte und anstößige Seiten; russische Infrastruktur.</string>
