    <string name="dns_desc_adguard">Bloquea anuncios, rastreadores, analíticas y malware. Algunos sitios pueden fallar (muros anti-adblock).</string>
    <string name="dns_desc_adguard_family">Bloquea contenido para adultos, anuncios, rastreadores y malware; activa la búsqueda segura.</string>
    <string name="dns_desc_adguard_unfiltered">Resolutor básico de AdGuard: sin bloqueos, privacidad ante todo, sin registros DNS.</string>
    <string name="dns_desc_cleanbrowsing_adult">Bloquea solo sitios para adultos (+18); todo lo demás está permitido.</string>
    <string name="dns_desc_cleanbrowsing_family">Modo estricto: bloquea contenido adulto, malware y phishing; búsqueda segura en Google/Bing/Yandex.</string>
    <string name="dns_desc_cloudflare">El resolutor público más rápido. Sin filtrado de contenido; registros borrados a las 24h.</string>
    <string name="dns_desc_cloudflare_family">Bloquea contenido para adultos (+18) y malware.</string>
    <string name="dns_desc_cloudflare_malware">La velocidad de Cloudflare más una lista de bloqueo de malware y phishing.</string>
    <string name="dns_desc_comodo">Bloquea dominios maliciosos y de phishing.</string>
    <string name="dns_desc_dns0_zero">Organización europea sin ánimo de lucro. Bloquea malware y phishing.</string>
    <string name="dns_desc_dns_watch">Alemán, orientado a la privacidad, sin filtros ni registros.</string>
    <string name="dns_desc_google">Anycast global de Google. Sin filtrado de contenido, política de privacidad estándar de Google.</string>
    <string name="dns_desc_level3">Resolutor clásico y veterano. Sin filtrado.</string>
    <string name="dns_desc_opendns">Resolutor de Cisco. Bloquea phishing y robo de identidad.</string>
    <string name="dns_desc_opendns_familyshield">Preconfigurado: bloquea contenido adulto y phishing. Nada que ajustar.</string>
    <string name="dns_desc_quad9">Bloquea malware, phishing y dominios de control de botnets. Sin ánimo de lucro suizo; sin registro de IP.</string>
    <string name="dns_desc_verisign">Infraestructura estable de EE. UU. Sin filtrado.</string>
    <string name="dns_desc_yandex">El más rápido en Rusia/CEI. Sin filtrado.</string>
    <string name="dns_desc_yandex_family">Bloquea contenido adulto y páginas sugerentes; infraestructura rusa.</string>
