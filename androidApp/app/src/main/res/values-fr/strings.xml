    <string name="dns_desc_adguard">Bloque publicités, traqueurs, balises d\'analyse et malwares. Certains sites peuvent dysfonctionner (anti-adblock).</string>
    <string name="dns_desc_adguard_family">Bloque contenus adultes, publicités, traqueurs et malwares ; force la recherche sécurisée.</string>
    <string name="dns_desc_adguard_unfiltered">Résolveur simple d\'AdGuard : aucun blocage, confidentialité d\'abord, aucun journal DNS.</string>
    <string name="dns_desc_cleanbrowsing_adult">Bloque uniquement les sites adultes (18+) ; tout le reste est autorisé.</string>
    <string name="dns_desc_cleanbrowsing_family">Mode strict : bloque contenus adultes, malwares et phishing ; recherche sûre sur Google/Bing/Yandex.</string>
    <string name="dns_desc_cloudflare">Le résolveur public le plus rapide. Aucun filtrage ; journaux supprimés après 24h.</string>
    <string name="dns_desc_cloudflare_family">Bloque les contenus pour adultes (18+) et les malwares.</string>
    <string name="dns_desc_cloudflare_malware">La vitesse de Cloudflare plus une liste de blocage malware et phishing.</string>
    <string name="dns_desc_comodo">Bloque les domaines malveillants et le phishing.</string>
    <string name="dns_desc_dns0_zero">Organisation à but non lucratif de l\'UE. Bloque les domaines malveillants et le phishing.</string>
    <string name="dns_desc_dns_watch">Allemand, respectueux de la vie privée, sans filtre ni journal.</string>
    <string name="dns_desc_google">Anycast mondial de Google. Aucun filtrage de contenu, politique de confidentialité Google standard.</string>
    <string name="dns_desc_level3">Résolveur vétéran classique. Aucun filtrage.</string>
    <string name="dns_desc_opendns">Résolveur de Cisco. Bloque le phishing et le vol d\'identité.</string>
    <string name="dns_desc_opendns_familyshield">Préconfiguré : bloque contenus adultes et phishing. Rien à régler.</string>
    <string name="dns_desc_quad9">Bloque les logiciels malveillants, le phishing et les domaines de contrôle de botnets. À but non lucratif suisse ; aucune journalisation d\'IP.</string>
    <string name="dns_desc_verisign">Infrastructure américaine stable. Aucun filtrage.</string>
    <string name="dns_desc_yandex">Le plus rapide en Russite/CEI. Aucun filtrage.</string>
    <string name="dns_desc_yandex_family">Bloque contenus adultes et pages suggestives ; infrastructure russe.</string>
