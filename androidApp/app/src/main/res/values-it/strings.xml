    <string name="dns_desc_adguard">Blocca pubblicità, tracker, beacon analitici e malware. Alcuni siti potrebbero non funzionare (anti-adblock).</string>
    <string name="dns_desc_adguard_family">Blocca contenuti per adulti, pubblicità, tracker e malware; impone la ricerca sicura.</string>
    <string name="dns_desc_adguard_unfiltered">Resolver semplice di AdGuard: nessun blocco, privacy prima di tutto, nessun log DNS.</string>
    <string name="dns_desc_cleanbrowsing_adult">Blocca solo i siti per adulti (18+); tutto il resto è consentito.</string>
    <string name="dns_desc_cleanbrowsing_family">Modalità severa: blocca contenuti adulti, malware e phishing; ricerca sicura su Google/Bing/Yandex.</string>
    <string name="dns_desc_cloudflare">Il resolver pubblico più veloce. Nessun filtraggio contenuti; log cancellati dopo 24h.</string>
    <string name="dns_desc_cloudflare_family">Blocca contenuti per adulti (18+) e domini malware.</string>
    <string name="dns_desc_cloudflare_malware">Velocità Cloudflare più blocklist di domini malware e phishing.</string>
    <string name="dns_desc_comodo">Blocca domini dannosi e di phishing.</string>
    <string name="dns_desc_dns0_zero">Non-profit europea. Blocca domini malware e phishing.</string>
    <string name="dns_desc_dns_watch">Tedesco, attento alla privacy, senza filtri né log.</string>
    <string name="dns_desc_google">Anycast globale di Google. Nessun filtraggio, normale informativa sulla privacy Google.</string>
    <string name="dns_desc_level3">Resolver storico e classico. Nessun filtraggio.</string>
    <string name="dns_desc_opendns">Resolver di Cisco. Blocca phishing e furto d\'identità.</string>
    <string name="dns_desc_opendns_familyshield">Preconfigurato: blocca contenuti per adulti e phishing. Nulla da impostare.</string>
    <string name="dns_desc_quad9">Blocca malware, phishing e domini di controllo dei botnet. Non-profit svizzera; nessun log degli IP.</string>
    <string name="dns_desc_verisign">Infrastruttura USA stabile. Nessun filtraggio.</string>
    <string name="dns_desc_yandex">Il più veloce in Russia/CIS. Nessun filtraggio.</string>
    <string name="dns_desc_yandex_family">Blocca contenuti per adulti e pagine discutibili; infrastruttura russa.</string>
