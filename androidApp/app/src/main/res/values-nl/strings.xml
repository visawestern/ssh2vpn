    <string name="dns_desc_adguard">Blokkeert advertenties, trackers, analytics en malwaredomeinen. Sommige sites kunnen breken (anti-adblockmuren).</string>
    <string name="dns_desc_adguard_family">Blokkeert volwassen inhoud, advertenties, trackers en malware; forceert veilig zoeken.</string>
    <string name="dns_desc_adguard_unfiltered">AdGuard\'s gewone resolver: geen blokkering, privacy voorop, geen DNS-logs.</string>
    <string name="dns_desc_cleanbrowsing_adult">Blokkeert alleen volwassen (18+) sites; alle rest is toegestaan.</string>
    <string name="dns_desc_cleanbrowsing_family">Strikte modus: blokkeert volwassen inhoud, malware en phishing; forceert veilig zoeken in Google/Bing/Yandex.</string>
    <string name="dns_desc_cloudflare">De snelste publieke resolver. Geen inhoudsfiltering; querylogs worden na 24 uur gewist.</string>
    <string name="dns_desc_cloudflare_family">Blokkeert volwassen (18+) inhoud en malwaredomeinen.</string>
    <string name="dns_desc_cloudflare_malware">Cloudflare-snelheid plus een blokkeerlijst van malware- en phishingdomeinen.</string>
    <string name="dns_desc_comodo">Blokkeert kwaadaardige en phishingdomeinen.</string>
    <string name="dns_desc_dns0_zero">EU non-profit. Blokkeert malware- en phishingdomeinen.</string>
    <string name="dns_desc_dns_watch">Duits, privacyvriendelijk, zonder filters of logs.</string>
    <string name="dns_desc_google">Google\'s wereldwijde anycast. Geen inhoudsfiltering, standaard Google-privacybeleid.</string>
    <string name="dns_desc_level3">Klassieke veteraan onder de resolvers. Geen filtering.</string>
    <string name="dns_desc_opendns">Resolver van Cisco. Blokkeert phishing en identiteitsdiefstal.</string>
    <string name="dns_desc_opendns_familyshield">Vooraf ingesteld: blokkeert volwassen inhoud en phishing. Niets in te stellen.</string>
    <string name="dns_desc_quad9">Blokkeert malware, phishing en botnet-commandodomeinen. Zwitsers non-profit; geen IP-logging.</string>
    <string name="dns_desc_verisign">Stabiele VS-infrastructuur. Geen filtering.</string>
    <string name="dns_desc_yandex">Het snelst in Rusland/GOS. Geen filtering.</string>
    <string name="dns_desc_yandex_family">Blokkeert volwassen inhoud en dubieuze pagina\'s; Russische infrastructuur.</string>
