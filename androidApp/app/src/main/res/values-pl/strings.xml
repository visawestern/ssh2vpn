    <string name="dns_tab_lists">Listy</string>
    <string name="dns_use_custom_info_body">Serwery te rozwiązują wszystkie nazwy domen, gdy tunel VPN jest aktywny. Wybierz publiczny preset lub wpisz własny. Zastosowane przy następnym połączeniu.</string>
    <string name="dns_use_custom_info_title">Własne serwery DNS</string>
    <string name="dns_desc_adguard">Blokuje reklamy, trackery, analitykę i domeny malware. Niektóre strony mogą się psuć (ściany anti-adblock).</string>
    <string name="dns_desc_adguard_family">Blokuje treści dla dorosłych, reklamy, trackery i malware; wymusza bezpieczne wyszukiwanie.</string>
    <string name="dns_desc_adguard_unfiltered">Zwykły resolver AdGuard: bez blokowania, prywatność przede wszystkim, bez logów DNS.</string>
    <string name="dns_desc_cleanbrowsing_adult">Blokuje tylko strony dla dorosłych (18+); cała reszta dozwolona.</string>
    <string name="dns_desc_cleanbrowsing_family">Tryb rygorystyczny: blokuje treści dla dorosłych, malware i phishing; wymusza Safe Search w Google/Bing/Yandex.</string>
    <string name="dns_desc_cloudflare">Najszybszy publiczny resolver. Bez filtrowania treści; logi zapytań usuwane po 24h.</string>
    <string name="dns_desc_cloudflare_family">Blokuje treści dla dorosłych (18+) i domeny malware.</string>
    <string name="dns_desc_cloudflare_malware">Szybkość Cloudflare plus lista blokowania domen malware i phishingu.</string>
    <string name="dns_desc_comodo">Blokuje złośliwe domeny i phishing.</string>
    <string name="dns_desc_dns0_zero">Unijna organizacja non-profit. Blokuje domeny malware i phishingu.</string>
    <string name="dns_desc_dns_watch">Niemiecki, przyjazny prywatności, bez filtrów i logów.</string>
    <string name="dns_desc_google">Globalny anycast Google. Bez filtrowania treści, standardowa polityka prywatności Google.</string>
    <string name="dns_desc_level3">Klasyczny weteran wśród resolverów. Bez filtrowania.</string>
    <string name="dns_desc_opendns">Resolver Cisco. Blokuje phishing i kradzież tożsamości.</string>
    <string name="dns_desc_opendns_familyshield">Skonfigurowany z góry: blokuje treści dla dorosłych i phishing. Niczego nie trzeba ustawiać.</string>
    <string name="dns_desc_quad9">Blokuje malware, phishing i domeny kontrolne botnetów. Szwajcarska organizacja non-profit; bez logowania IP.</string>
    <string name="dns_desc_verisign">Stabilna infrastruktura USA. Bez filtrowania.</string>
    <string name="dns_desc_yandex">Najszybszy w Rosji/ONS. Bez filtrowania.</string>
    <string name="dns_desc_yandex_family">Blokuje treści dla dorosłych i wątpliwe strony; rosyjska infrastruktura.</string>
