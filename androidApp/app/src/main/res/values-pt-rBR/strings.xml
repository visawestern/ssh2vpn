    <string name="dns_desc_adguard">Bloqueia anúncios, rastreadores, análises e malware. Alguns sites podem falhar (bloqueio anti-adblock).</string>
    <string name="dns_desc_adguard_family">Bloqueia conteúdo adulto, anúncios, rastreadores e malware; força a busca segura.</string>
    <string name="dns_desc_adguard_unfiltered">Resolvedor simples da AdGuard: sem bloqueios, privacidade em primeiro lugar, sem registros de DNS.</string>
    <string name="dns_desc_cleanbrowsing_adult">Bloqueia apenas sites adultos (18+); todo o resto é permitido.</string>
    <string name="dns_desc_cleanbrowsing_family">Modo estrito: bloqueia conteúdo adulto, malware e phishing; busca segura no Google/Bing/Yandex.</string>
    <string name="dns_desc_cloudflare">O resolvedor público mais rápido. Sem filtragem de conteúdo; registros apagados após 24h.</string>
    <string name="dns_desc_cloudflare_family">Bloqueia conteúdo adulto (18+) e domínios de malware.</string>
    <string name="dns_desc_cloudflare_malware">Velocidade da Cloudflare mais lista de bloqueio de domínios de malware e phishing.</string>
    <string name="dns_desc_comodo">Bloqueia domínios maliciosos e de phishing.</string>
    <string name="dns_desc_dns0_zero">Organização europeia sem fins lucrativos. Bloqueia domínios de malware e phishing.</string>
    <string name="dns_desc_dns_watch">Alemão, focado em privacidade, sem filtros nem registros.</string>
    <string name="dns_desc_google">Anycast global do Google. Sem filtragem de conteúdo, política de privacidade padrão do Google.</string>
    <string name="dns_desc_level3">Resolvedor clássico e veterano. Sem filtragem.</string>
    <string name="dns_desc_opendns">Resolvedor da Cisco. Bloqueia phishing e roubo de identidade.</string>
    <string name="dns_desc_opendns_familyshield">Pré-configurado: bloqueia conteúdo adulto e phishing. Nada para configurar.</string>
    <string name="dns_desc_quad9">Bloqueia malware, phishing e domínios de comando de botnets. Sem fins lucrativos suíço; sem registro de IPs.</string>
    <string name="dns_desc_verisign">Infraestrutura estável dos EUA. Sem filtragem.</string>
    <string name="dns_desc_yandex">O mais rápido na Rússia/CIS. Sem filtragem.</string>
    <string name="dns_desc_yandex_family">Bloqueia conteúdo adulto e páginas sugestivas; infraestrutura russa.</string>
