    <string name="dns_use_custom_info_body">Các máy chủ này phân giải mọi tên miền khi đường hầm VPN hoạt động. Chọn cài đặt công khai hoặc nhập của riêng bạn. Áp dụng từ lần kết nối sau.</string>
    <string name="dns_use_custom_info_title">Máy chủ DNS tùy chỉnh</string>
    <string name="dns_desc_adguard">Chặn quảng cáo, trình theo dõi, phân tích và miền mã độc. Một số trang có thể hỏng (tường chống adblock).</string>
    <string name="dns_desc_adguard_family">Chặn nội dung người lớn, quảng cáo, theo dõi và mã độc; buộc tìm kiếm an toàn.</string>
    <string name="dns_desc_adguard_unfiltered">Bộ phân giải giản đơn của AdGuard: không chặn gì, ưu tiên riêng tư, không lưu nhật ký DNS.</string>
    <string name="dns_desc_cleanbrowsing_adult">Chỉ chặn trang người lớn (18+); còn lại đều được phép.</string>
    <string name="dns_desc_cleanbrowsing_family">Chế độ nghiêm: chặn nội dung người lớn, mã độc, lừa đảo; buộc tìm kiếm an toàn trên Google/Bing/Yandex.</string>
    <string name="dns_desc_cloudflare">Bộ phân giải công khai nhanh nhất. Không lọc nội dung; nhật ký truy vấn bị xóa sau 24 giờ.</string>
    <string name="dns_desc_cloudflare_family">Chặn nội dung người lớn (18+) và miền mã độc.</string>
    <string name="dns_desc_cloudflare_malware">Tốc độ Cloudflare kèm danh sách chặn miền mã độc và lừa đảo.</string>
    <string name="dns_desc_comodo">Chặn miền độc hại và lừa đảo.</string>
    <string name="dns_desc_dns0_zero">Tổ chức phi lợi nhuận EU. Chặn miền mã độc và lừa đảo.</string>
    <string name="dns_desc_dns_watch">Đức, thân thiện quyền riêng tư, không lọc, không nhật ký.</string>
    <string name="dns_desc_google">Anycast toàn cầu của Google. Không lọc nội dung, chính sách quyền riêng tư chuẩn của Google.</string>
    <string name="dns_desc_level3">Bộ phân giải lâu đời kinh điển. Không lọc.</string>
    <string name="dns_desc_opendns">Bộ phân giải của Cisco. Chặn lừa đảo và đánh cắp danh tính.</string>
    <string name="dns_desc_opendns_familyshield">Cài sẵn: chặn nội dung người lớn và lừa đảo. Không cần cấu hình.</string>
    <string name="dns_desc_quad9">Chặn mã độc, lừa đảo và miền điều khiển botnet. Tổ chức phi lợi nhuận Thụy Sĩ; không ghi log IP.</string>
    <string name="dns_desc_verisign">Hạ tầng Mỹ ổn định. Không lọc.</string>
    <string name="dns_desc_yandex">Nhanh nhất ở Nga/CIS. Không lọc.</string>
    <string name="dns_desc_yandex_family">Chặn nội dung người lớn và trang khiêu khích; hạ tầng Nga.</string>
