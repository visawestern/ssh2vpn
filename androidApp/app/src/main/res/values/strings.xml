    <string name="dns_desc_adguard">Blocks ads, trackers, analytics beacons and malware domains. Some sites may break (anti-adblock walls).</string>
    <string name="dns_desc_adguard_family">Blocks adult content, ads, trackers and malware; enforces safe search in engines.</string>
    <string name="dns_desc_adguard_unfiltered">AdGuard\'s plain resolver: no blocking at all, privacy-first, no DNS logs.</string>
    <string name="dns_desc_cleanbrowsing_adult">Blocks only adult (18+) sites; everything else is allowed.</string>
    <string name="dns_desc_cleanbrowsing_family">Strict mode: blocks adult content, malware and phishing; forces safe search on Google/Bing/Yandex.</string>
    <string name="dns_desc_cloudflare">The fastest public resolver. No content filtering; query logs deleted after 24h.</string>
    <string name="dns_desc_cloudflare_family">Blocks adult (18+) content and malware domains.</string>
    <string name="dns_desc_cloudflare_malware">Cloudflare speed plus a blocklist of malware and phishing domains.</string>
    <string name="dns_desc_comodo">Blocks malicious and phishing domains.</string>
    <string name="dns_desc_dns0_zero">EU non-profit. Blocks malware and phishing domains.</string>
    <string name="dns_desc_dns_watch">German, privacy-friendly, no filtering, no logs.</string>
    <string name="dns_desc_google">Google\'s global anycast. No content filtering, standard Google privacy policy.</string>
    <string name="dns_desc_level3">Classic veteran resolver. No filtering.</string>
    <string name="dns_desc_opendns">Cisco\'s resolver. Blocks phishing and identity-theft sites.</string>
    <string name="dns_desc_opendns_familyshield">Preconfigured: blocks adult content and phishing. Nothing to set up.</string>
    <string name="dns_desc_quad9">Blocks malware, phishing and botnet command domains. Swiss non-profit; no IP logging.</string>
    <string name="dns_desc_verisign">Stable US infrastructure. No filtering.</string>
    <string name="dns_desc_yandex">Fastest in Russia/CIS region. No filtering.</string>
    <string name="dns_desc_yandex_family">Blocks adult content and suggestive pages; Russian infrastructure.</string>
